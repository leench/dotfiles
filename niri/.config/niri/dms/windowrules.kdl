// @id=wr_1771687872353053518 @name=1password
window-rule {
    match app-id="^1password$"
    opacity 1.0
    open-floating true
}

// @id=wr_1773069598195049960 @name=org.gnome.FileRoller
window-rule {
    match app-id="^org.gnome.FileRoller$"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}
