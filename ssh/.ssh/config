Host aliyun-mutagen
    HostName 10.10.10.250
    User leen
    ProxyJump jumper
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

    ServerAliveInterval 15
    ServerAliveCountMax 3
    ExitOnForwardFailure yes
    TCPKeepAlive yes

    ControlMaster no
    ControlPath none
    ControlPersist no
    RequestTTY no
    
# 全局配置
Host *
    ServerAliveInterval 15
    ServerAliveCountMax 3
    ExitOnForwardFailure yes
    TCPKeepAlive yes
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h:%p
    ControlPersist 1h

# OpenMediaVault
Host omv
    HostName 192.168.100.20
    User leen

# TrueNAS
Host tnas
    HostName 192.168.100.21
    User leen

# ZMK 41 (Keyboard/Controller)
Host zmk41
    HostName 192.168.100.31
    User leen

Host pi
    HostName leen-rpi.local
    User leen
    AddressFamily inet

Host cpi
    HostName 192.168.100.80
    User leen
    HostKeyAlias uconsole-debian

Host nixpi
    HostName 192.168.100.80
    User leen
    HostKeyAlias uconsole-nixos

Host ccc
    HostName 192.168.100.40
    User leen

Host openclaw
    HostName 192.168.100.204
    User leen

Host niri
    HostName 192.168.100.220
    User niri

Host sherpa
    HostName 192.168.100.35
    User leen
    ForwardAgent yes

Host myali
    HostName 8.156.72.42
    User leen
    ForwardAgent yes

# 阿里云堡垒机 (Jumper)
Host jumper
    HostName dmtonhcvgh-public.bastionhost.aliyuncs.com
    Port 60022
    User leen

# 阿里云服务器 (通过堡垒机跳板)
Host aliyun
    HostName 10.10.10.250
    User leen
    Port 22
    ProxyJump jumper

Host 10.10.10.*
    User leen
    Port 22
    ProxyJump jumper
