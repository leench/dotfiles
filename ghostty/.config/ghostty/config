# --- 字体与显示 ---
font-family = "Noto Sans Mono"
font-family = "Noto Sans Mono CJK SC"
font-size = 10.5
adjust-cell-height = 8
font-codepoint-map = U+3400-U+4DBF,U+4E00-U+9FFF,U+F900-U+FAFF,U+20000-U+2A6DF,U+2A700-U+2B73F,U+2B740-U+2B81F,U+2B820-U+2CEAF,U+2F800-U+2FA1F=Noto Sans Mono CJK SC
scrollback-limit = 10000000
focus-follows-mouse = true
shell-integration-features = no-cursor

# --- 主题与透明度 ---
theme = "Catppuccin Mocha"
background-opacity = 1.0
background-opacity-cells = false
background-blur = 0

# --- 窗口装饰 ---
window-decoration = none
window-padding-x = 4
window-padding-y = 4
confirm-close-surface = false

# --- 光标 ---
cursor-style = block
cursor-style-blink = true

# --- 鼠标与剪贴板 ---
mouse-hide-while-typing = true
copy-on-select = clipboard

# --- 快捷键 ---
keybind = alt+d=new_split:right
keybind = alt+e=new_split:down
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up

# 保持和当前 Kitty 一样，Ctrl+C 优先发送 SIGINT
keybind = ctrl+c=text:\x03
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+r=reload_config
