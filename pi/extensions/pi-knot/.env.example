# pi-knot 示例环境（不要提交真实 Token）。
# 凭证优先级：非空 KNOT_AGENT_TOKEN → 用户级 ~/.pi/agent/mcp.json 的 mcpServers.knot 中
# Authorization: Bearer 头。Token 不会写进 knot.json、状态文件或会话记录。
# 自动处理开关不走环境变量，写在 ~/.pi/agent/knot.json 的 "autoExecuteMentions": true（默认 false）。
export KNOT_REST_URL="https://knot.example.com"
export KNOT_WS_URL="wss://knot.example.com/ws/agent-sessions/5"
export KNOT_AGENT_SESSION_ID="5"
export KNOT_AGENT_TOKEN="<在这里填入 Agent Token>"
