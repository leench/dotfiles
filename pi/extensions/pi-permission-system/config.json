{
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": true,
  "doublePressToConfirm": false,
  "piInfrastructureReadPaths": [
    "~/.pi/**",
    "~/.nvm/**"
  ],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/.ssh/*": "allow"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "ask",
    "edit": "ask",
    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow",
      "mcp_search": "allow",
      "mcp_describe": "allow"
    },
    "skill": {
      "*": "ask"
    },
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "cd *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "more *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "tree *": "allow",
      "which *": "allow",
      "type *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "ag *": "allow",
      "find *": "allow",
      "wc *": "allow",
      "diff *": "allow",
      "cmp *": "allow",
      "nl *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "jq *": "allow",
      "md5sum *": "allow",
      "sha*sum *": "allow",
      "tar -t*": "allow",
      "unzip -l*": "allow",
      "ps *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch": "allow",
      "git branch --list*": "allow",
      "git remote -v": "allow",
      "git tag": "allow",
      "git tag --list*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git check-ignore*": "allow",
      "git blame*": "allow",
      "git grep*": "allow",
      "git stash list*": "allow",
      "git stash show*": "allow",
      "git config --get*": "allow",
      "git config --list*": "allow",
      "*>*": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/.pi/*": "allow",
      "~/.nvm/*": "allow"
    }
  }
}
